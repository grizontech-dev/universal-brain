{
  "name": "grizon-ai-backend-2",
  "version": "1.0.0",
  "description": "Foundation backend scaffold for Layer 2 API Gateway",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db/migrations/run.ts",
    "migrate:create": "tsx src/db/migrations/create.ts",
    "seed": "tsx src/db/seed.ts",
    "reset-agents": "tsx src/db/reset-agents.ts",
    "migrate:prod": "node dist/db/migrations/run.js",
    "seed:prod": "node dist/db/seed.js",
    "reset-agents:prod": "node dist/db/reset-agents.js",
    "keys:generate": "node scripts/generate-jwt-keys.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maulikatwork/grizon-ai-backend-2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/maulikatwork/grizon-ai-backend-2/issues"
  },
  "homepage": "https://github.com/maulikatwork/grizon-ai-backend-2#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@google/generative-ai": "^0.24.1",
    "@mozilla/readability": "^0.6.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.76.5",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "google-auth-library": "^9.6.1",
    "helmet": "^8.1.0",
    "jose": "^5.9.2",
    "jsdom": "^29.1.1",
    "marked": "^18.0.3",
    "openai": "^6.36.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.2",
    "redis": "^4.7.0",
    "sanitize-html": "^2.17.3",
    "uuid": "^11.1.0",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "supertest": "^7.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
